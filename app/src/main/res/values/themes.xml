<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.SmartCampus" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_light_blue</item>
        <item name="colorSecondaryVariant">@color/accent_sky</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/bg_light_gray</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Ripple color -->
        <item name="colorControlHighlight">@color/ripple_color</item>
    </style>

    <!-- Splash Theme for Seamless Startup -->
    <style name="Theme.SmartCampus.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/primary_navy</item>
    </style>

    <!-- Custom Button Styles -->
    <style name="Widget.SmartCampus.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary_navy</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.SmartCampus.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/secondary_light_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/secondary_light_blue</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.SmartCampus.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_medium</item>
        <item name="cardElevation">@dimen/card_elevation_low</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>

