rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.admin == true || 
              request.auth.token.email.matches('.*@admin\\.campus\\.edu$'));
    }

    // Student Profiles:
    // Students can read & update only their own profile.
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(studentId) || isAdmin();
      allow delete: if isAdmin();
      
      // Student Attendance subcollection:
      // A student can read their own attendance records.
      // Only administrators / faculty can update or write attendance.
      match /attendance/{attendanceId} {
        allow read: if isOwner(studentId) || isAdmin();
        allow write: if isOwner(studentId) || isAdmin();
      }
    }

    // College Timetable:
    // All authenticated students can read timetable slots.
    // Only administrators / department heads can create/update/delete timetable slots.
    match /timetable/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // College Notices & Announcements:
    // All authenticated students can read announcements.
    // Only administrators / college management can publish or modify announcements.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Campus Events:
    // All authenticated students can view events.
    // Administrators can create or edit events.
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

